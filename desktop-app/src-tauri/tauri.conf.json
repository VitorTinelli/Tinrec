{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tinrec",
  "version": "0.2.0",
  "identifier": "com.tinelli.tinrec",
  "build": {
    "beforeDevCommand": "npm --prefix .. run desktop:web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix .. run desktop:web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tinrec",
        "width": 1080,
        "height": 810,
        "minWidth": 760,
        "minHeight": 650,
        "center": true,
        "backgroundColor": "#f6f7fb"
      },
      {
        "label": "controls",
        "title": "Tinrec \u00b7 controles",
        "url": "index.html?window=controls",
        "width": 490,
        "height": 56,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "contentProtected": true,
        "backgroundColor": "#1b2130",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Gravador local de tela e \u00e1udio",
    "category": "Video",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg",
          "libpipewire-0.3-0",
          "libasound2",
          "libdbus-1-3"
        ]
      },
      "rpm": {
        "depends": [
          "ffmpeg",
          "pipewire-libs",
          "alsa-lib",
          "dbus-libs"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
