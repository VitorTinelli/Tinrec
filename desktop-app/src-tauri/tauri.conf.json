{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tinrec",
  "version": "0.3.0",
  "identifier": "com.tinelli.tinrec",
  "build": {
    "beforeDevCommand": "npm --prefix .. run desktop:web:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm --prefix .. run desktop:web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Tinrec",
        "width": 820,
        "height": 700,
        "minWidth": 700,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#f7f8fa"
      },
      {
        "label": "controls",
        "create": false,
        "title": "Tinrec · controles",
        "url": "index.html?window=controls",
        "width": 536,
        "height": 56,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "contentProtected": true,
        "backgroundColor": "#1d2636",
        "center": true
      },
      {
        "label": "webcam",
        "create": false,
        "title": "Tinrec · webcam",
        "url": "index.html?window=webcam",
        "width": 216,
        "height": 216,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "contentProtected": true,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000"
      },
      {
        "label": "area",
        "create": false,
        "title": "Tinrec · selecionar área",
        "url": "index.html?window=area",
        "width": 800,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "contentProtected": true,
        "transparent": true,
        "shadow": false,
        "backgroundColor": "#00000000"
      },
      {
        "label": "print-area",
        "create": false,
        "title": "Tinrec · print",
        "url": "index.html?window=print-area",
        "width": 800,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "contentProtected": true,
        "transparent": false,
        "shadow": false,
        "backgroundColor": "#161b25"
      },
      {
        "label": "capture-border",
        "create": false,
        "title": "Tinrec · limite da gravação",
        "url": "index.html?window=capture-border",
        "width": 100,
        "height": 100,
        "visible": false,
        "focusable": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "contentProtected": true,
        "transparent": true,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://tinrec-print.localhost https://tinrec-print.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://tinrec-print.localhost https://tinrec-print.localhost; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; frame-src 'none'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Gravador local de tela e áudio",
    "category": "Video",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg",
          "libpipewire-0.3-0",
          "libasound2",
          "libdbus-1-3"
        ]
      },
      "rpm": {
        "depends": [
          "ffmpeg",
          "pipewire-libs",
          "alsa-lib",
          "dbus-libs"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
