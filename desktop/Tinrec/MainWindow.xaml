<Window x:Class="Tinrec.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Tinrec" Icon="Assets/icon.png" Width="540" Height="830" MinHeight="600" MinWidth="480" Background="#FAF9FD" Foreground="#302B40" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
  <DockPanel Margin="0,0,0,22"><TextBlock Text="◉ tinrec." FontSize="29" FontWeight="Bold" Foreground="#6954DD"/><TextBlock DockPanel.Dock="Right" Text="GRAVE. COMPARTILHE." FontSize="9" Foreground="#A39AAE" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel>
  <TextBlock Text="Uma ideia merece um vídeo." FontSize="22" FontWeight="SemiBold"/>
  <TextBlock Text="Capture sua tela. O link fica por nossa conta." Foreground="#968AAB" Margin="0,6,0,18"/>
  <Expander Header="Conta e preferências" Margin="0,0,0,18" x:Name="SettingsExpander"><StackPanel Margin="0,12,0,0" x:Name="SettingsPanel"><TextBlock Text="Endereço do seu site Tinrec"/><TextBox x:Name="SiteUrl" ToolTip="https://seu-projeto.vercel.app"/><Button x:Name="ConnectButton" Content="Conectar com Google" Click="Connect_Click" HorizontalAlignment="Left"/><TextBlock x:Name="ConnectionStatus" TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#8C7CA4"/><TextBlock Text="Nome padrão dos vídeos"/><TextBox x:Name="Prefix"/><Button Content="Salvar preferências" Click="Save_Click" HorizontalAlignment="Left"/></StackPanel></Expander>
  <StackPanel x:Name="CaptureSettings"><TextBlock Text="Título desta gravação"/><TextBox x:Name="VideoTitle" MaxLength="180"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Monitor"/><ComboBox x:Name="Displays" DisplayMemberPath="Label" SelectionChanged="Display_Changed"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Qualidade"/><ComboBox x:Name="Resolution" SelectedIndex="1"><ComboBoxItem Content="720p"/><ComboBoxItem Content="1080p"/></ComboBox></StackPanel></Grid>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><Button x:Name="FullScreenButton" Content="Tela inteira" Click="FullScreen_Click"/><Button Content="Selecionar área" Click="Area_Click"/><TextBlock x:Name="RegionLabel" Text="Tela inteira" VerticalAlignment="Center" FontSize="10" Foreground="#9B8DAC"/></StackPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><CheckBox x:Name="Microphone" Content="Microfone" IsChecked="True"/><ComboBox x:Name="Inputs" DisplayMemberPath="Label"/></StackPanel><StackPanel Grid.Column="1"><CheckBox x:Name="SystemAudio" Content="Áudio do computador" IsChecked="True"/><ComboBox x:Name="Outputs" DisplayMemberPath="Label"/></StackPanel></Grid></StackPanel>
  <Border Background="White" BorderBrush="#E8E1F0" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,8,0,14"><StackPanel><DockPanel><TextBlock x:Name="TimerLabel" Text="00:00" FontSize="30" FontWeight="Light"/><TextBlock x:Name="StateLabel" Text="Tudo pronto para gravar" Foreground="#9B8BAA" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="StartButton" Content="●  Iniciar gravação" Background="#6954DD" Foreground="White" Click="Start_Click"/><Button x:Name="PauseButton" Content="Pausar" Click="Pause_Click" IsEnabled="False"/><Button x:Name="StopButton" Content="Parar" Click="Stop_Click" IsEnabled="False"/></StackPanel></StackPanel></Border>
  <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="#826C9C" Margin="0,0,0,12"/>
  <DockPanel Margin="0,0,0,10"><TextBlock Text="Seus envios" FontWeight="SemiBold"/><Button DockPanel.Dock="Right" Content="Abrir biblioteca ↗" Click="Library_Click" HorizontalAlignment="Right" FontSize="10" Padding="8,4"/></DockPanel>
  <ListBox x:Name="Queue" MaxHeight="180" BorderBrush="#E8E1F0" Background="White" DisplayMemberPath="Display" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
  <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Copiar link" Click="Copy_Click" Padding="10,6" FontSize="11"/><Button Content="Tentar envio" Click="Retry_Click" Padding="10,6" FontSize="11"/><Button Content="Arquivos locais" Click="Files_Click" Padding="10,6" FontSize="11"/></StackPanel>
  <TextBlock Text="Seus vídeos ficam no seu Google Drive. Mantenha o aplicativo aberto até o envio terminar." TextWrapping="Wrap" FontSize="10" Foreground="#AAA0B7" Margin="0,18,0,0"/>
 </StackPanel></ScrollViewer>
</Window>
